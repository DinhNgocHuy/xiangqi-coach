# Copy to the process environment (or a local, untracked .env loaded by your shell). No real values here.
# Backend always binds 127.0.0.1; only the port is configurable.
XQC_PORT=8765
# SQLite file. Default: %APPDATA%\XiangqiCoach\coach.db (Windows) or ~/.local/share/xiangqi-coach/coach.db
XQC_DB_PATH=
# Path to the Pikafish executable (phase 4). Empty = <repo>/engine/pikafish/pikafish[.exe] (scripts/fetch_pikafish.py)
XQC_PIKAFISH_PATH=
# AI Thinking Coach (phase 5). Provider: anthropic | huggingface | none.
# Empty = anthropic if XQC_LLM_API_KEY is set, else huggingface if XQC_HF_TOKEN is set, else none (coach disabled,
# the app keeps rule-based feedback). Never commit a real key/token. Only text is sent (FEN, moves, scores, the
# player's answers), never images.
XQC_LLM_PROVIDER=
# Anthropic API key and model ID (empty = claude-opus-5-5)
XQC_LLM_API_KEY=
XQC_LLM_MODEL=
# Hugging Face Inference Providers: fine-grained token with "Make calls to Inference Providers" permission
# (https://huggingface.co/settings/tokens). Model empty = Qwen/Qwen3-235B-A22B-Instruct-2507; any chat model on
# https://huggingface.co/models?inference_provider=all, optional suffix ":fastest", ":cheapest" or ":<provider>".
XQC_HF_TOKEN=
XQC_HF_MODEL=
# DEBUG | INFO | WARNING | ERROR
XQC_LOG_LEVEL=INFO
# Pikafish resource limits (phase 4). Threads default min(2, CPUs); Hash in MB.
XQC_ENGINE_THREADS=
XQC_ENGINE_HASH_MB=128
XQC_ENGINE_MAX_DEPTH=30
XQC_ENGINE_MAX_MOVETIME_MS=10000
